# Copy to .env for local overrides (do NOT commit .env with real credentials)
# Leave DATABASE_URL unset to use local SQLite (backend/patients.db)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Comma-separated allowed CORS origins (use * for open public demo or specify frontend URL)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set to true when serving built frontend/dist directly from FastAPI
SERVE_STATIC=false
